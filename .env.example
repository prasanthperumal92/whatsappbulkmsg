# Copied here by `vercel env pull` once T1.2 is done. Real values never go in Git.
DATABASE_URL=
# Direct (non-pooled) connection, used for migrations
DATABASE_URL_UNPOOLED=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_TELEMETRY_DISABLED=1
# openssl rand -base64 32
APP_ENCRYPTION_KEY=
CRON_SECRET=
EMAIL_UNSUBSCRIBE_SECRET=
# First allowlist emails (H-3), comma-separated. Applied by db:migrate only while the list is empty
TEAM_BOOTSTRAP_EMAILS=
# Optional. The base URL for links in emails, when it isn't this deployment's own domain
APP_URL=
