{
  "$spec": "SPEC.md §4.5, FR-IMP-05",
  "description": "Phone normalisation goldens. Input is the raw CSV cell (read as text) plus an optional mapped country-code column. Default country is IN unless `default_country` is given. Expected is either {phone_e164, wa_to} or {reject}. Verified against libphonenumber-js/max 1.x.",
  "cases": [
    { "id": "PN-01", "raw": "98765 43210", "expect": { "phone_e164": "+919876543210", "wa_to": "919876543210" }, "note": "Bare 10-digit Indian mobile with space" },
    { "id": "PN-02", "raw": "098765 43210", "expect": { "phone_e164": "+919876543210", "wa_to": "919876543210" }, "note": "Trunk 0 (spec example)" },
    { "id": "PN-03", "raw": "+91 98765-43210", "expect": { "phone_e164": "+919876543210", "wa_to": "919876543210" } },
    { "id": "PN-04", "raw": "0091 9876543210", "expect": { "phone_e164": "+919876543210", "wa_to": "919876543210" }, "note": "Leading 00 converted to +" },
    { "id": "PN-05", "raw": "(098) 7654-3210", "expect": { "phone_e164": "+919876543210", "wa_to": "919876543210" }, "note": "Parentheses and dash stripped" },
    { "id": "PN-06", "raw": "98765.43210", "expect": { "phone_e164": "+919876543210", "wa_to": "919876543210" }, "note": "Dot stripped" },
    { "id": "PN-07", "raw": "+919876543210", "expect": { "phone_e164": "+919876543210", "wa_to": "919876543210" }, "note": "Already E.164" },
    { "id": "PN-08", "raw": "919876543210", "expect": { "phone_e164": "+919876543210", "wa_to": "919876543210" }, "note": "Country code without + (libphonenumber strips it). SPEC GAP G-01: behaviour not stated" },
    { "id": "PN-09", "raw": "6000000000", "expect": { "phone_e164": "+916000000000", "wa_to": "916000000000" }, "note": "Indian mobile starting 6" },
    { "id": "PN-10", "raw": "7012345678", "expect": { "phone_e164": "+917012345678", "wa_to": "917012345678" } },
    { "id": "PN-11", "raw": "8123456789", "expect": { "phone_e164": "+918123456789", "wa_to": "918123456789" } },
    { "id": "PN-12", "raw": "+1 415 555 2671", "expect": { "phone_e164": "+14155552671", "wa_to": "14155552671" }, "note": "Explicit foreign number keeps its own country" },
    { "id": "PN-13", "raw": "+44 7911 123456", "expect": { "phone_e164": "+447911123456", "wa_to": "447911123456" } },
    { "id": "PN-14", "raw": "+65 9123 4567", "expect": { "phone_e164": "+6591234567", "wa_to": "6591234567" } },
    { "id": "PN-15", "raw": "9876543210", "country_code": "91", "expect": { "phone_e164": "+919876543210", "wa_to": "919876543210" }, "note": "Country-code column" },
    { "id": "PN-16", "raw": "9876543210", "country_code": "+91", "expect": { "phone_e164": "+919876543210", "wa_to": "919876543210" }, "note": "Country-code column value carries a +" },
    { "id": "PN-17", "raw": "501234567", "country_code": "971", "expect": { "phone_e164": "+971501234567", "wa_to": "971501234567" }, "note": "Country-code column overrides default IN" },
    { "id": "PN-18", "raw": "0501234567", "country_code": "971", "expect": { "phone_e164": "+971501234567", "wa_to": "971501234567" }, "note": "Trunk 0 with country-code column" },
    { "id": "PN-19", "raw": "9.19876E+11", "expect": { "reject": "SCIENTIFIC_NOTATION" }, "note": "Excel damage (spec example)" },
    { "id": "PN-20", "raw": "9.19876543210E+11", "expect": { "reject": "SCIENTIFIC_NOTATION" }, "note": "Full-precision scientific notation is still rejected, not reconstructed" },
    { "id": "PN-21", "raw": "", "expect": { "reject": "EMPTY_PHONE" } },
    { "id": "PN-22", "raw": "   ", "expect": { "reject": "EMPTY_PHONE" }, "note": "Whitespace only counts as empty" },
    { "id": "PN-23", "raw": "12345", "expect": { "reject": "INVALID_PHONE" } },
    { "id": "PN-24", "raw": "+91 55555 55555", "expect": { "reject": "INVALID_PHONE" } },
    { "id": "PN-25", "raw": "+91 98765 4321", "expect": { "reject": "INVALID_PHONE" }, "note": "One digit short" },
    { "id": "PN-26", "raw": "98765432101", "expect": { "reject": "INVALID_PHONE" }, "note": "One digit long" },
    { "id": "PN-27", "raw": "+999 1234567", "expect": { "reject": "INVALID_PHONE" }, "note": "Unassigned country code" },
    { "id": "PN-28", "raw": "abcdef", "expect": { "reject": "INVALID_PHONE" } },
    { "id": "PN-29", "raw": "+919876543210;+919812345678", "expect": { "reject": "INVALID_PHONE" }, "note": "Two numbers in one cell are not split" },
    { "id": "PN-30", "raw": "9876 543 210 ", "expect": { "phone_e164": "+919876543210", "wa_to": "919876543210" }, "note": "Trailing non-breaking space (common in Excel exports). SPEC GAP G-02: §4.5 only says 'spaces'" },
    { "id": "PN-31", "raw": "022 2345 6789", "expect": { "phone_e164": "+912223456789", "wa_to": "912223456789" }, "note": "Mumbai landline is a valid number. SPEC GAP G-03: should fixed-line numbers be rejected or flagged?" },
    { "id": "PN-32", "raw": "+91 98765 43210 ext 5", "expect": { "phone_e164": "+919876543210", "wa_to": "919876543210" }, "note": "libphonenumber drops the extension. SPEC GAP G-04: accept silently or reject?" }
  ]
}
