    { "id": "EC-08", "code": 131056, "action": "retry_after_60s" },
    { "id": "EC-09", "code": 131026, "action": "failed", "retryable_by_retry_failed": false },
    { "id": "EC-10", "code": 131049, "action": "failed_manual_retry_after_24h", "retryable_by_retry_failed": "only when failed_at < now - 24h" },
    { "id": "EC-11", "code": 131050, "action": "failed_and_suppress", "suppression_reason": "error_131050", "retryable_by_retry_failed": false },
    { "id": "EC-12", "code": 131047, "action": "failed", "retryable_by_retry_failed": false },
    { "id": "EC-13", "code": 132000, "action": "pause_campaign", "note": "Mapping bug that affects every recipient" },
    { "id": "EC-14", "code": 132001, "action": "pause_campaign" },
