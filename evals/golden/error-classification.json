    { "id": "EC-03", "code": 10,     "action": "pause_campaign", "banner": "permission" },
    { "id": "EC-04", "code": 200,    "action": "pause_campaign", "banner": "permission" },
    { "id": "EC-05", "code": 4,      "action": "retry_backoff" },
