      "id": "TV-01",
      "note": "Baseline from §7.3: valid, no warnings",
      "draft": {
        "name": "festive_offer_nov26",
        "parameter_format": "NAMED",
        "body": "Hi {{first_name}}, our festive offer is live! Get {{discount}} off all orders placed this week.",
        "samples": {
          "first_name": "Asha",
          "discount": "15%"
        },
        "footer": "Reply STOP to unsubscribe",
        "buttons": [
          {
            "type": "URL",
            "text": "View offer",
            "url": "https://example.com/offer/{{1}}",
            "example": "https://example.com/offer/FEST15"
          },
          {
            "type": "QUICK_REPLY",
            "text": "Stop promotions"
          }
        ]
      },
      "expect": {
        "errors": [],
        "warnings": []
      }
