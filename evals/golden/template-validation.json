{
  "$spec": "SPEC.md §5.7 (editor fields, live validation), FR-TPL-02",
  "description": "Template draft → blocking error codes and warning codes (order-insensitive sets). Codes are this suite's vocabulary; map them to the implementation's codes in one place. A case with empty errors and warnings must validate clean.",
  "codes": {
    "errors": [
      "E_BODY_EMPTY",
      "E_LENGTH_BODY",
      "E_LENGTH_HEADER",
      "E_LENGTH_FOOTER",
      "E_LENGTH_BUTTON",
      "E_NAME",
      "E_MISSING_SAMPLE",
      "E_POSITIONAL_SEQUENCE",
      "E_NAMED_FORMAT",
      "E_VARIABLE_AT_EDGE",
      "E_FOOTER_VARIABLE",
      "E_HEADER_VARIABLES",
      "E_BUTTON_LIMIT",
      "E_BUTTON_URL"
    ],
    "warnings": [
      "W_ADJACENT_VARIABLES",
      "W_NO_OPT_OUT",
      "W_URL_SHORTENER",
      "W_VARIABLE_DENSITY"
    ]
  },
  "cases": [
