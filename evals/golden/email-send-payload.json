        "discount": {
          "static": "15%"
        },
        "offer_code": {
          "attribute": "offer_code"
        }
      },
      "contact": {
        "email": "asha@example.com",
        "first_name": "<b>Asha & Co</b>",
        "attributes": {
          "offer_code": "FEST15"
        }
      },
      "message_id": "0192f4e0-0000-7000-8000-000000000042",
      "expect": {
        "subject": "<b>Asha & Co</b>, our festive offer is live",
        "html_contains": [
          "&lt;b&gt;Asha &amp; Co&lt;/b&gt;"
        ],
        "html_not_contains": [
          "<b>Asha"
        ],
        "text_contains": [
          "Hi <b>Asha & Co</b>, get"
        ]
      }
    },
