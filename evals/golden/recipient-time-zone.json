      "country_iso": "GB",
      "mapped": null,
      "expect": "Europe/London",
      "uses_fallback": false
    },
    {
      "id": "TZ-03",
      "country_iso": "US",
      "mapped": null,
      "expect": "America/Chicago",
      "uses_fallback": false,
