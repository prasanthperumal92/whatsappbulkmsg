    },
    {
      "id": "TZ-04",
      "country_iso": "US",
      "mapped": "America/New_York",
      "expect": "America/New_York",
      "uses_fallback": false
    },
    {
      "id": "TZ-05",
      "country_iso": "CA",
      "mapped": null,
      "expect": "America/Toronto",
      "uses_fallback": false
    },
    {
